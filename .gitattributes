* text=auto eol=lf

*.php text diff=php
*.js text
*.css text
*.json text
*.xml text
*.txt text
*.pot text
*.md text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Exclude development files from GitHub auto-generated source archives.
/.github export-ignore
/tests export-ignore
/phpunit.xml.dist export-ignore
/phpcs.xml.dist export-ignore
/.editorconfig export-ignore
/.distignore export-ignore
/bin export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/README.md export-ignore
